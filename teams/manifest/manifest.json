{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "00000000-0000-0000-0000-000000000001",
  "packageName": "com.peoplepath.portal",
  "name": {
    "short": "PeoplePath Portal",
    "full": "PeoplePath Resource Management Portal"
  },
  "description": {
    "short": "Resource management portal",
    "full": "Minimalistic portal for resources, timesheets, and AI assistance"
  },
  "icons": {
    "color": "https://dummyimage.com/192x192/2563eb/ffffff.png&text=P",
    "outline": "https://dummyimage.com/32x32/ffffff/2563eb.png&text=P"
  },
  "accentColor": "#2563eb",
  "staticTabs": [
    {
      "entityId": "resourcePortal",
      "name": "Portal",
      "contentUrl": "https://localhost:3000",
      "scopes": ["personal"],
      "websiteUrl": "https://localhost:3000"
    }
  ],
  "bots": [
    {
      "botId": "00000000-0000-0000-0000-000000000000",
      "scopes": ["personal"],
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["personal"],
          "commands": [
            {"title": "/timesheet suggest", "description": "Get AI draft entries"},
            {"title": "/timesheet status", "description": "Current week status"}
          ]
        }
      ]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["localhost", "127.0.0.1"]
}
